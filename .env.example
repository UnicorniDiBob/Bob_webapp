# Supabase — progetto Bob_webapp
NEXT_PUBLIC_SUPABASE_URL=https://bijgitnulucdzluqjxrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# Service role key: usata solo server-side per creare account CS senza conferma email.
# Trovala in Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic — AI di Bob (opzionale: senza chiave usa il fallback a regole)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Account di PROVA per scripts/prova_chiamante.mjs, che fa il login da solo e
# prova cookie / Bearer / Bearer scaduto / niente su un server locale. Meglio
# un cliente, mai un account vero: il token resta in memoria allo script.
BOB_TEST_EMAIL=
BOB_TEST_PASSWORD=

# URL pubblico del sito (usato per i metadata SEO)
NEXT_PUBLIC_SITE_URL=https://www.meetonda.com
